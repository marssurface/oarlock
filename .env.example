# Provider: deepseek | openai | ollama | mock
# Empty means auto-detect: a key picks its provider, otherwise mock.
AGENT_PROVIDER=

# Model name for the selected provider.
AGENT_MODEL=

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Any other OpenAI-compatible service
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# e.g. Volcengine Ark coding endpoint:
# AGENT_PROVIDER=openai
# OPENAI_API_KEY=ark-...
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# AGENT_MODEL=deepseek-v4.1-flash-economy

# Local Ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Runtime knobs
AGENT_MAX_STEPS=24
AGENT_MAX_RETRIES=2
AGENT_CONTEXT_WINDOW=65536
AGENT_APPROVAL=ask
AGENT_TEMPERATURE=0.3
AGENT_ALLOW_SHELL=1
# How many `task` delegations one turn may run at once.
AGENT_MAX_CONCURRENT_SUBAGENTS=3
# Optional per-turn budgets (empty = unlimited): total tokens incl. subagents, and wall-clock ms.
# AGENT_MAX_TURN_TOKENS=
# AGENT_MAX_TURN_MS=
# Opt-in gateway debugging: dump each raw model request/response to .agent/recordings.
# AGENT_RECORD=1
# Override the dump directory (also enables recording on its own):
# AGENT_RECORD_DIR=
# Workspace snapshots before each turn (shadow git in .agent/checkpoints, never your .git).
# AGENT_CHECKPOINT=0 disables the feature; AGENT_GIT_PATH points at a specific git binary.
# AGENT_GIT_PATH=
